{
	"compilerOptions": {
		"target": "es5",
		"baseUrl": "src",
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"esModuleInterop": true,
		"module": "ES2020",
		"types": ["node"],
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": false,
		"noEmit": true,
		"jsx": "react-jsx",
		"pretty": true,
		"sourceMap": true,
		"paths": {
			"@app/*": ["./*"]
		},
		"experimentalDecorators": true,
		"useDefineForClassFields": true
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
